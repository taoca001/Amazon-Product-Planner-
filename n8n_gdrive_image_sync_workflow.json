{
  "name": "Google Drive → Produkt-Bilder Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drive-image-sync",
        "options": {}
      },
      "id": "webhook-sync-trigger",
      "name": "Webhook: Drive-Sync ausgelöst",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [180, 300],
      "webhookId": "drive-image-sync"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst productId = body.product_id;\nconst folderId = body.folder_id;\nconst name = body.name || '';\n\nif (!productId || !folderId) {\n  throw new Error('product_id oder folder_id fehlt');\n}\n\nreturn [{ json: { productId, folderId, name } }];"
      },
      "id": "prepare-sync",
      "name": "Daten vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "list",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $json.folderId }}",
          "mode": "id"
        },
        "options": {
          "fields": ["id", "name", "mimeType", "size"]
        }
      },
      "id": "list-files",
      "name": "Dateien im Ordner auflisten",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [620, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst productId = $('Daten vorbereiten').first().json.productId;\n\nconst allowedMimes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];\n\nconst images = items\n  .filter(item => allowedMimes.includes(item.json.mimeType))\n  .map(item => ({\n    json: {\n      productId,\n      fileId: item.json.id,\n      fileName: item.json.name,\n      mimeType: item.json.mimeType,\n      // Typ aus Dateiname ableiten: enthält 'raw' → raw, sonst product\n      imageType: item.json.name.toLowerCase().includes('raw') ? 'raw' : 'product'\n    }\n  }));\n\nif (images.length === 0) {\n  return [{ json: { skipped: true, message: 'Keine Bilder gefunden' } }];\n}\n\nreturn images;"
      },
      "id": "filter-images",
      "name": "Bilder filtern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": "={{ $json.fileId }}",
        "options": {}
      },
      "id": "download-image",
      "name": "Bild herunterladen",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1060, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.LARAVEL_APP_URL || 'http://host.docker.internal:8000') + '/api/products/' + $('Bilder filtern').item.json.productId + '/images/upload' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LARAVEL_API_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "image",
              "inputDataFieldName": "data"
            },
            {
              "parameterType": "formData",
              "name": "type",
              "value": "={{ $('Bilder filtern').item.json.imageType }}"
            },
            {
              "parameterType": "formData",
              "name": "gdrive_file_id",
              "value": "={{ $('Bilder filtern').item.json.fileId }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "upload-to-laravel",
      "name": "Upload zu Laravel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 300]
    }
  ],
  "connections": {
    "Webhook: Drive-Sync ausgelöst": {
      "main": [[{ "node": "Daten vorbereiten", "type": "main", "index": 0 }]]
    },
    "Daten vorbereiten": {
      "main": [[{ "node": "Dateien im Ordner auflisten", "type": "main", "index": 0 }]]
    },
    "Dateien im Ordner auflisten": {
      "main": [[{ "node": "Bilder filtern", "type": "main", "index": 0 }]]
    },
    "Bilder filtern": {
      "main": [[{ "node": "Bild herunterladen", "type": "main", "index": 0 }]]
    },
    "Bild herunterladen": {
      "main": [[{ "node": "Upload zu Laravel", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
